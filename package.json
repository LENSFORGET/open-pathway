{
  "name": "open-pathway",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual, privacy-first planning experience and open-source frontend portfolio.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "check": "npm run build && npm test && npm run audit:public",
    "package:public": "npm run check && node scripts/package-public.mjs",
    "format": "prettier --write src tests scripts worker *.md *.json *.mjs index.html .github/workflows/ci.yml"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.9.6",
    "vite": "6.4.3"
  }
}
